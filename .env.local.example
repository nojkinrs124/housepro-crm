# HousePro CRM — переменные окружения
# Скопируй в .env.local и заполни значениями из Supabase Dashboard

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Секретный pepper для HMAC-хеширования публичных API-ключей (src/lib/api-auth.ts)
# Сгенерировать: openssl rand -hex 32
API_KEY_PEPPER=your-random-64-char-hex-pepper

# Sentry — мониторинг ошибок (https://sentry.io)
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=housepro-crm
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ── Почта ───────────────────────────────────────────────────────────────────
# Провайдер выбирается автоматически по наличию ключа; EMAIL_PROVIDER —
# явное переопределение (resend | unisender | log). Без ключей письма не уходят,
# а пишутся в консоль и в email_log со статусом skipped.
EMAIL_PROVIDER=
RESEND_API_KEY=
UNISENDER_API_KEY=
EMAIL_FROM=noreply@housepro24.ru
EMAIL_FROM_NAME=HousePro CRM

# Секрет для Vercel Cron (/api/cron/*)
CRON_SECRET=

# ── DaData: подсказки адресов, организаций и банков ─────────────────────────
# Токен «API-ключ» из личного кабинета dadata.ru (не «секретный ключ» —
# для подсказок он не нужен). Без ключа поля работают как обычный ввод.
DADATA_API_KEY=

# ── Яндекс.Карты ────────────────────────────────────────────────────────────
# Ключ JS API (developer.tech.yandex.ru → Кабинет разработчика → JavaScript API
# и HTTP Геокодер). Без ключа карты просто не отображаются, остальное работает.
NEXT_PUBLIC_YANDEX_MAPS_KEY=

# ── OpenRouter: Telegram-бот, посты канала, генератор объявлений ────────────
# Без ключа кнопка «Сгенерировать объявление» отвечает 503, остальное работает.
OPENROUTER_API_KEY=
# Модель по умолчанию для всех вызовов (anthropic/claude-sonnet-5, если пусто)
OPENROUTER_MODEL=
# Отдельная модель только для объявлений; пусто — берётся OPENROUTER_MODEL
OPENROUTER_LISTING_MODEL=

# ── Фото объектов: Yandex Object Storage ────────────────────────────────────
# STORAGE_DRIVER=yandex переключает загрузку фото в бакет Яндекса; пусто или
# supabase — старый бакет property-photos в Supabase Storage. Ключи — статический
# ключ сервисного аккаунта с ролью storage.editor (console.yandex.cloud).
# Перенос уже загруженных фото — `npm run migrate:photos` (см. scripts/).
STORAGE_DRIVER=
YC_S3_ENDPOINT=https://storage.yandexcloud.net
YC_S3_REGION=ru-central1
YC_S3_BUCKET=housepro-photos
YC_S3_KEY_ID=
YC_S3_SECRET=
